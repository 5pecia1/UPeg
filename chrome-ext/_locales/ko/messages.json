      "file": { "content": "$1", "example": "image.gif" },
      "extensions": { "content": "$2", "example": ".png, .jpg" }
    }
  },
  "fileTooLarge": {
    "message": "\"$FILE$\"은(는) $ACTUAL$ bytes이며 파일별 제한은 $LIMIT$ bytes입니다.",
    "placeholders": {
      "file": { "content": "$1", "example": "image.png" },
      "actual": { "content": "$2", "example": "20" },
      "limit": { "content": "$3", "example": "10" }
    }
  },
  "fileTotalTooLarge": {
    "message": "\"$FIELD$\"의 합계는 $ACTUAL$ bytes이며 정책 제한은 $LIMIT$ bytes입니다.",
    "placeholders": {
      "field": { "content": "$1", "example": "images" },
      "actual": { "content": "$2", "example": "20" },
      "limit": { "content": "$3", "example": "10" }
    }
  },
