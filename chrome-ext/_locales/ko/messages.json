      "limit": { "content": "$3", "example": "128" }
    }
  },
  "fileExtensionNotAllowed": {
    "message": "\"$FILE$\"은(는) 허용되지 않은 파일 형식입니다. 허용 형식: $EXTENSIONS$.",
