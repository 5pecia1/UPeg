  "fileTooMany": {
    "message": "\"$FIELD$\"에는 최대 $LIMIT$개 파일을 선택할 수 있지만 $ACTUAL$개가 선택되었습니다.",
    "placeholders": {
      "field": { "content": "$1", "example": "images" },
      "actual": { "content": "$2", "example": "3" },
      "limit": { "content": "$3", "example": "2" }
    }
  },
  "fileTooManyNodes": {
    "message": "\"$FIELD$\"이(가) 만드는 파일 node는 $ACTUAL$개이며 제한은 $LIMIT$개입니다.",
