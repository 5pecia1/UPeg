# Rust build artifacts
/target/
target/
*.rs.bk
.sisyphus/

# Node dependencies and logs
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local frontend build artifacts
/chrome-ext/dist/
/flutter_app/web/toolkits/

# Environment files
.env
.env.*
!.env.example

# Editor/OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp 

# Misc local temp outputs
/tmp/

# Python bytecode
__pycache__/
*.py[cod]

# cargo internal cache files; not source code
.cargo/.global-cache
.cargo/.package-cache
.cargo/.package-cache-mutate

# Generated Zensical documentation site (built at the public export root)
/site/

# Wrangler's local Cloudflare Pages state. Credentials are never stored here,
# but the cache is machine-specific and must not enter a release source tree.
/.wrangler/
